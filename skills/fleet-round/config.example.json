{
  "schema": "fleet-round.config/v1",
  "chief": { "session": "fleet-chief", "pane": "%1" },
  "projects": {
    "app": {
      "root": "~/src/app",
      "identity_keys": ["~/src/app"],
      "director": { "session": "app-round", "pane": "%11" }
    },
    "kit": {
      "root": "~/src/kit-tracker",
      "repo": "~/src/kit",
      "doc_ref": "origin/main",
      "identity_keys": ["~/src/kit-tracker", "~/src/kit"]
    }
  },
  "seats": {
    "tmux_sockets": ["~/.tmux-sockets/tmux-501/default"],
    "identity_root": "~/.config/agent-mail/identity",
    "agent_markers": ["/.bun/bin/omp", "/pi-coding-agent/dist/cli.js"]
  },
  "stale_hours": 24,
  "frontier_top": 3,
  "approver": "Operator",
  "barrier": {
    "agent_mail_db": "~/.local/share/mcp-agent-mail-rust-live/storage.sqlite3",
    "mail_project": "~/src/fleet",
    "hours": { "INSIGHT": 2, "AGREE": 1, "SORT": 8 },
    "deliver": false
  }
}
