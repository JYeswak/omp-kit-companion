{
  "schema": "fleet-round.config/v1",
  "chief": { "session": "fleet-chief", "pane": "tern:1001" },
  "projects": {
    "app": {
      "root": "~/src/app",
      "holders": { "AppDirector": { "session": "app-round", "pane": "tern:1002" } },
      "director": { "session": "app-round", "pane": "tern:1002" }
    },
    "kit": {
      "root": "~/src/kit-tracker",
      "repo": "~/src/kit",
      "doc_ref": "origin/main",
      "holders": { "KitDirector": { "session": "kit-round", "pane": "tern:1003" } }
    }
  },
  "stale_hours": 24,
  "frontier_top": 3,
  "approver": "Operator",
  "barrier": {
    "board_channel": "fleet",
    "hours": { "INSIGHT": 2, "AGREE": 1, "SORT": 8 },
    "deliver": false
  }
}
