			"call": { "path": "target", "text": "new", "mode": 384, "durability": "full" },
			"expect": { "ok": true, "published": true, "file_synced": true, "directory_synced": true, "durable": true, "files": { "target": "new" }, "modes": { "target": 384 }, "entries": { ".": ["target"] } }
		},
		{
			"id": "replace-durability-none",
			"setup": [{ "file": "target", "text": "old" }],
			"call": { "path": "target", "text": "new", "mode": 384, "durability": "none" },
			"expect": { "ok": true, "published": true, "file_synced": false, "directory_synced": false, "durable": false, "files": { "target": "new" }, "entries": { ".": ["target"] } }
		},
		{
			"id": "replace-durability-file",
			"setup": [{ "file": "target", "text": "old" }],
			"call": { "path": "target", "text": "new", "mode": 384, "durability": "file" },
			"expect": { "ok": true, "published": true, "file_synced": true, "directory_synced": false, "durable": false, "files": { "target": "new" }, "entries": { ".": ["target"] } }
		},
