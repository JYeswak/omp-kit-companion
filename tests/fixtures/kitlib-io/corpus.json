			"writes": 200,
			"size": 262144,
			"reader_argv": ["python3", "-c", "import os,sys\np,stop,ready=sys.argv[1],sys.argv[2],sys.argv[3]\na,b=b'a'*int(sys.argv[4]),b'b'*int(sys.argv[4])\nopen(ready,'wb').close()\nn=t=0\nwhile not os.path.exists(stop):\n    with open(p,'rb') as f:\n        d=f.read(len(a)+1)\n    n+=1\n    t+=d!=a and d!=b\nprint('reads=%d torn=%d'%(n,t))", "{DIR}/target", "{DIR}/stop", "{DIR}/ready", "262144"],
			"expect": { "reader_torn": 0, "entries": { ".": ["ready", "stop", "target"] } }
		},
