<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.omp-kit.omp-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/fixture/user-home/test-op/.local/bin/omp-kit</string>
		<string>service</string>
		<string>run</string>
		<string>omp-watch</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/fixture/user-home/test-op</string>
		<key>XDG_STATE_HOME</key>
		<string>/fixture/user-home/test-op/.local/state</string>
		<key>TMPDIR</key>
		<string>/fixture/user-home/test-op/.local/state/omp-kit/service-tmp</string>
		<key>PATH</key>
		<string>/fixture/user-home/test-op/.local/bin:/fixture/user-home/test-op/.bun/bin:/fixture/user-home/test-op/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>OMP_KIT_JOB</key>
		<string>omp-watch</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/fixture/user-home/test-op/Library/Logs/omp-kit/omp-watch.out.log</string>
	<key>StandardErrorPath</key>
	<string>/fixture/user-home/test-op/Library/Logs/omp-kit/omp-watch.err.log</string>
	<key>WatchPaths</key>
	<array>
		<string>/fixture/user-home/test-op/pkg.json</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>/fixture/user-home/test-op</string>
</dict>
</plist>
