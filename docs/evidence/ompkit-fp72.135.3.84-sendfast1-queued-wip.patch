+
+export function steerReceiptPath(home: string, sessionFile: string, marker: string): string {
+	const key = createHash("sha1").update(sessionFile).digest("hex").slice(0, 16);
+	return join(home, ".local", "state", "omp-kit", "steer-queue", key, `${marker}.json`);
+}
+
+/** The marker a kit send ends with: a last line exactly `[kit-send-<12 lowercase hex>]`, else null. */
+export function kitSendMarker(text: string): string | null {
+	const trimmed = text.trim();
+	const last = trimmed.slice(trimmed.lastIndexOf("\n") + 1);
+	if (last.length !== 23 || !last.startsWith("[kit-send-") || !last.endsWith("]")) return null;
+	for (const ch of last.slice(10, 22)) if (!((ch >= "0" && ch <= "9") || (ch >= "a" && ch <= "f"))) return null;
+	return last.slice(1, 22);
+}
