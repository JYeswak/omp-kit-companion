+/**
+ * SENDFAST1 QUEUED_STEER (ompkit-fp72.135.3.84, J-2026-10-30-04): OMP's own receipt that a kit send pasted into a busy
+ * seat reached its steering queue. omp holds a steer until the running tool call ends before it journals it, so the
+ * journal proof can take as long as that call (a 60 s bash call held one 19 s). The seat records, per marker, that its
+ * `input` hook saw the exact submitted text while the agent was streaming with nothing queued, and that omp's queue
+ * then held a message. The sender reads this as QUEUED_STEER: queued, never proven. The text itself is never written.
+ */
+export interface SteerReceiptRecord {
+	schema: 1;
+	session_file: string;
+	pid: number;
+	/** Epoch milliseconds the input hook saw the submit. */
+	at: number;
+	marker: string;
+	/** sha256 of the submitted text, trimmed: what the journal entry will hold. */
+	text_sha256: string;
