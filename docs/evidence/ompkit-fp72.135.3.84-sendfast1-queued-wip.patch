+// SENDFAST1 QUEUED_STEER (ompkit-fp72.135.3.84, J-2026-10-30-04): the seat's own receipt that a kit send reached omp's queue.
+const SEND_TEXT = "[from agent PeachLeopard via omp-kit send]\nstatus update\n[kit-send-0123456789ab]";
+
+/** A streaming seat whose queue is empty until `queuedAfterChecks` re-reads, then holds the message. */
+async function streamingSeat(queuedAfterChecks: number | null, opts: { pendingBefore?: boolean; optedIn?: boolean } = {}) {
+	const s = await seat({ optedIn: opts.optedIn });
+	let checks = 0;
+	s.ctx.isIdle = () => false;
+	s.ctx.hasPendingMessages = () => {
+		checks++;
+		if (checks === 1) return opts.pendingBefore === true;
+		return queuedAfterChecks !== null && checks - 1 >= queuedAfterChecks;
+	};
+	const receipt = (marker = "kit-send-0123456789ab") => {
+		const path = steerReceiptPath(s.home, realpathSync(s.sessionFile), marker);
+		return existsSync(path) ? { path, record: JSON.parse(readFileSync(path, "utf8")) as SteerReceiptRecord } : null;
+	};
+	return { ...s, receipt };
+}
+
