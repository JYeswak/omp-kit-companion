+			detail = `queued at ${rec.queuedAt}; waiting for its journal entry until ${rec.deadlineAt} (${proof.status} ${proof.reason})`;
+		}
+		if (outcome !== "QUEUED") settleTernPending(pendingDir, name, rec, outcome, offset);
+		steers.push({ ...row, outcome, offset, detail });
+	}
+	const overall = steers.some((row) => QUEUED_STEER_FAILURES[row.outcome] === true) ? "FINDINGS"
+		: steers.some((row) => row.outcome === "QUEUED") ? "QUEUED" : "OK";
+	return { overall, steers };
+}
