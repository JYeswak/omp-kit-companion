+// ---- SENDFAST1 QUEUED_STEER (ompkit-fp72.135.3.84, J-2026-10-30-04): a busy seat's queued steer returns fast, never as proof ----
+
+interface HeldFake { journal: string; held: string; pastes: number; enters: number; receiptReads: number; io: TernObserverIo; release: () => void }
+interface HeldSteer {
+	fake: HeldFake;
+	steerReceipt: (sessionFile: string, marker: string) => SteerReceipt | null;
+	busy: () => Promise<TernObservation>;
+	receiptFile: string;
+}
+/** A busy keyless seat in a long tool call: Enter submits the paste into omp's steering queue and nothing is journaled
+ * until `release()` (the tool call ends). `receipt` is what the seat's kit-composer-state would write. */
+function heldSteerFake(receipt: "omp" | "none" | ((held: string, marker: string) => SteerReceipt | null) = "omp"): HeldSteer {
+	const fake: HeldFake = { journal: inFlightJournal, held: "", pastes: 0, enters: 0, receiptReads: 0, io: undefined as unknown as TernObserverIo,
+		release: () => { fake.journal += userEntry("steer-1", "a3", fake.held.trim(), { steering: true }); } };
+	let composer = "";
+	fake.io = {
+		run: (argv: string[]) => {
+			const send = argv.indexOf("send");
+			if (send >= 0 && argv[send + 2] === "paste") { fake.pastes++; composer += argv[send + 3] ?? ""; }
+			if (send >= 0 && argv[send + 2] === "keys") { fake.enters++; fake.held = composer; composer = ""; }
+			return { code: 0, out: "" };
+		},
+		readSessionFile: () => fake.journal,
+		wait: noWait,
+	};
+	const receiptFile = join(scratch, `steer-receipt-${Math.random().toString(36).slice(2)}.json`);
+	const steerReceipt = (_sessionFile: string, marker: string): SteerReceipt | null => {
+		fake.receiptReads++;
+		if (!fake.held.includes(`[${marker}]`)) return null;
+		if (typeof receipt === "function") return receipt(fake.held, marker);
+		if (receipt === "none") return null;
+		writeFileSync(receiptFile, "{}");
+		return { path: receiptFile, pid: ternRuntimeBinding.foregroundPid, at: Date.now(), textSha256: sha(fake.held.trim()) };
+	};
+	const busy = async (): Promise<TernObservation> => ({ ...ternIdle, state: "BUSY", working: true, oracleBusy: null,
+		sessionSha: sha(fake.journal), sessionCursorBytes: Buffer.byteLength(fake.journal) });
+	return { fake, steerReceipt, busy, receiptFile };
+}
+function deliverHeld(h: HeldSteer, dropDir: string, over: Partial<Parameters<typeof deliverToTernSeat>[0]> = {}) {
+	return deliverToTernSeat({ seat: keylessSeat, text: "status update", dropDir, io: h.fake.io, observe: h.busy,
+		identify: async () => ternIdentified, untilDeliveredMs: TERN_TURN_BOUNDARY_WAIT_MS, pollMs: 10, deadlineMs: 200, wait: noWait,
+		composer: () => ({ state: "EMPTY" }), acceptQueuedSteer: true, steerReceipt: h.steerReceipt, ...over });
+}
+function pendingFiles(dropDir: string): string[] {
+	const dir = join(dropDir, "..", "tern-pending");
+	return existsSync(dir) ? readdirSync(dir).filter((name) => name.endsWith(".json")) : [];
+}
+
+test("SENDFAST1.queued: a busy seat whose omp queued the steer returns QUEUED_STEER at once, with a deferred record and a drop copy", async () => {
+	const h = heldSteerFake();
+	const dropDir = ternDropDir();
+	const started = performance.now();
+	const r = await deliverHeld(h, dropDir);
+	expect(performance.now() - started).toBeLessThan(1_000);
+	expect(r).toMatchObject({ status: "QUEUED", code: "QUEUED_STEER", sends: 1, offset: null });
+	expect([h.fake.pastes, h.fake.enters, h.fake.receiptReads]).toEqual([1, 1, 1]);
+	expect(readFileSync(r.drop_path!, "utf8")).toContain("status update");
+	expect(pendingFiles(dropDir)).toEqual([basename(r.deferred_path!)]);
+	expect(r.deferred_path!.endsWith(`${r.marker}.queued.json`)).toBe(true);
+	expect(existsSync(h.receiptFile)).toBe(false);
+	// QUEUED never satisfies a PROVEN check: not OK, no PROVEN code, no PROVEN anywhere in what the caller sees.
+	expect(r.status).not.toBe("OK");
+	expect(JSON.stringify(r)).not.toContain("PROVEN");
+	expect(reportQueuedSteers({ dropDir, io: h.fake.io })).toMatchObject({ overall: "QUEUED", steers: [{ marker: r.marker, outcome: "QUEUED" }] });
+});
