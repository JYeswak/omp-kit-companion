+	await Promise.all(s.confirmations);
+	const got = s.receipt();
+	expect(got?.record).toEqual({ schema: 1, session_file: realpathSync(s.sessionFile), pid: 4242, at: 1_000,
+		marker: "kit-send-0123456789ab", text_sha256: createHash("sha256").update(SEND_TEXT.trim(), "utf8").digest("hex") });
+	expect(readFileSync(got!.path, "utf8")).not.toContain("status update");
+	expect(s.sleeps).toEqual([STEER_RECEIPT_POLL_MS, STEER_RECEIPT_POLL_MS, STEER_RECEIPT_POLL_MS]);
+});
+
