+                           str(judge_root / "scripts/suite-file-inputs.ts"), str(suite_root)], deadline_s=120)
+        proofs = json.loads(raw)
+    except (OSError, ValueError, TypeError) as error:
+        print("FILEREUSE: analyser cannot prove inputs; all files run: " + str(error), file=sys.stderr)
+        return {}
+    keys = {}
+    shared = (*load_metrics(judge_root).JUDGING_FILES, "scripts/gate-ci-only.tsv",
+              "bunfig.toml", "package.json", "tsconfig.json")
+    for path, proof in proofs.items():
+        if proof.get("provable") is not True:
+            continue
+        inputs = {}
+        try:
+            for name in sorted(set(proof["inputs"]) | set(shared)):
+                relative = Path(name)
+                target = suite_root / relative
+                if (relative.is_absolute() or ".." in relative.parts or target.is_symlink()
+                        or any((suite_root / parent).is_symlink() for parent in relative.parents)):
+                    raise ValueError("unsafe file input: " + name)
+                if target.is_file():
+                    digest = hashlib.sha256()
+                    with target.open("rb") as handle:
+                        for chunk in iter(lambda: handle.read(1 << 20), b""):
+                            digest.update(chunk)
+                    inputs[name] = digest.hexdigest()
+                elif target.exists():
+                    raise ValueError("input is not a regular file: " + name)
+                else:
+                    inputs[name] = None
+        except (OSError, ValueError) as error:
+            print(f"FILEREUSE: {path} has unprovable inputs; running: {error}", file=sys.stderr)
+            continue
