+#!/usr/bin/env bun
+// FILEREUSE: an intentionally small closed language, not an effect heuristic.
+// No computed properties, ambient names, side-effect imports, dynamic reads,
+// external modules, callbacks supplied as values, configuration or preloads.
+// Anything outside this grammar is unprovable and must execute natively.
+import { existsSync, readFileSync } from "node:fs";
+import { dirname, join, normalize } from "node:path";
+import { fileInputGraph, FULL_SUITE_TRIGGERS, isTestFile } from "./affected-tests.ts";
+
+type Token = { text: string; literal: boolean };
+function tokens(source: string): Token[] {
+	const out: Token[] = [];
+	const letter = (c: string) => c >= "a" && c <= "z" || c >= "A" && c <= "Z" || c === "_";
+	const digit = (c: string) => c >= "0" && c <= "9";
+	for (let i = 0; i < source.length;) {
+		const c = source[i]!;
+		if (" \t\r\n".includes(c)) { i++; continue; }
+		if (source.startsWith("//", i)) { while (i < source.length && source[i] !== "\n") i++; continue; }
+		if (source.startsWith("/*", i)) {
+			const end = source.indexOf("*/", i + 2);
+			if (end < 0) throw new Error("unterminated comment");
+			i = end + 2; continue;
+		}
+		if (c === '"' || c === "'") {
+			const start = ++i;
+			while (i < source.length && source[i] !== c) {
+				if (source[i] === "\\" || source[i] === "\n" || source[i] === "\r") throw new Error("escaped or multiline literal");
+				i++;
+			}
+			if (i === source.length) throw new Error("unterminated literal");
+			out.push({ text: source.slice(start, i++), literal: true }); continue;
+		}
+		const start = i++;
+		if (letter(c)) while (i < source.length && (letter(source[i]!) || digit(source[i]!))) i++;
+		else if (digit(c)) while (i < source.length && (digit(source[i]!) || source[i] === ".")) i++;
+		else if (!"(){};,=+-*!<>?:.".includes(c)) throw new Error("unsupported token");
+		out.push({ text: source.slice(start, i), literal: false });
+	}
+	return out;
+}
+
+// Recursive descent over a closed expression language. The scope contains only
+// proven local values/functions and parameters; assertions cannot become values.
+function importsOf(source: string): string[] {
+	const ts = tokens(source);
+	let at = 0;
+	const scope = new Set<string>();
+	const callable = new Set<string>();
+	const imports: string[] = [];
+	let hasTest = false, hasExpect = false;
+	const peek = (text: string) => ts[at]?.text === text && !ts[at]?.literal;
+	const take = (text: string) => { if (!peek(text)) throw new Error(`expected ${text}`); at++; };
+	const name = () => {
+		const token = ts[at++];
+		if (!token || token.literal || !token.text || !"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".includes(token.text[0]!)) throw new Error("expected local name");
+		if (["test", "expect", "true", "false", "null", "return", "import", "export", "const", "function"].includes(token.text)) throw new Error("reserved name");
+		return token.text;
+	};
+	const literal = () => { const token = ts[at++]; if (!token?.literal) throw new Error("expected literal"); return token.text; };
+	const expression = (locals: ReadonlySet<string>): void => {
+		const primary = (): void => {
+			if (peek("!") || peek("-") || peek("+")) { at++; primary(); return; }
+			if (peek("(")) { at++; expression(locals); take(")"); return; }
+			const token = ts[at++];
+			if (!token) throw new Error("missing expression");
+			if (token.literal || ["true", "false", "null"].includes(token.text) || Number.isFinite(Number(token.text))) return;
+			if (!locals.has(token.text) && !scope.has(token.text)) throw new Error("ambient identifier");
+			if (peek("(")) {
+				if (!callable.has(token.text) || locals.has(token.text)) throw new Error("unproven callable");
+				at++;
+				if (!peek(")")) { expression(locals); while (peek(",")) { at++; expression(locals); } }
+				take(")");
+			}
+		};
+		primary();
+		while (ts[at] && !ts[at]!.literal && ["+", "-", "*", "<", ">", "=", "!"].includes(ts[at]!.text)) {
+			// Operators need no evaluation here: Bun separately parses every module.
+			at++;
+			while (peek("=")) at++;
+			primary();
+		}
+		if (peek("?")) { at++; expression(locals); take(":"); expression(locals); }
+	};
+	while (at < ts.length) {
+		if (peek("import")) {
+			at++; take("{");
+			const names: string[] = [];
+			while (!peek("}")) {
+				const token = ts[at++];
+				if (!token || token.literal) throw new Error("unsupported import");
+				names.push(token.text);
+				if (!peek(",")) break;
+				at++;
+			}
+			take("}"); take("from"); const specifier = literal(); take(";");
+			if (specifier === "bun:test") {
+				if (names.some((n) => n !== "test" && n !== "expect")) throw new Error("unsupported test API");
+				hasTest ||= names.includes("test"); hasExpect ||= names.includes("expect");
+			} else {
+				if (!specifier.startsWith("./") && !specifier.startsWith("../")) throw new Error("external import");
+				imports.push(specifier);
+				for (const n of names) {
+					if (["test", "expect"].includes(n) || scope.has(n)) throw new Error("shadowed name");
+					scope.add(n); callable.add(n);
+				}
+			}
+		} else if (peek("test")) {
+			if (!hasTest || !hasExpect) throw new Error("missing test API");
+			at++; take("("); literal(); take(","); take("("); take(")"); take("="); take(">"); take("{");
+			let assertions = 0;
+			while (!peek("}")) {
+				take("expect"); take("("); expression(new Set()); take(")"); take(".");
+				if (!peek("toBe") && !peek("toEqual")) throw new Error("unsupported assertion");
+				at++; take("("); expression(new Set()); take(")"); take(";"); assertions++;
+			}
+			if (!assertions) throw new Error("empty test");
+			take("}"); take(")"); take(";");
+		} else {
+			if (peek("export")) at++;
+			if (peek("const")) {
+				at++; const n = name(); if (scope.has(n)) throw new Error("shadowed binding");
+				take("="); expression(new Set()); take(";"); scope.add(n);
+			} else {
+				take("function"); const n = name(); if (scope.has(n)) throw new Error("shadowed binding");
+				scope.add(n); callable.add(n); take("("); const locals = new Set<string>();
+				if (!peek(")")) { locals.add(name()); while (peek(",")) { at++; locals.add(name()); } }
+				take(")"); take("{"); take("return"); expression(locals); take(";"); take("}");
+			}
+		}
+	}
+	return imports;
+}
+
+export type FileInputProof = { inputs: string[]; provable: boolean; reason: string };
+export function proveFileInputs(root: string): Record<string, FileInputProof> {
+	const graph = fileInputGraph(root);
+	// Bun/TS configuration can install preloads, aliases, macros or extends outside
+	// the graph. Until those effects have a proof, every affected suite stays cold.
+	const loaderNames = ["package.json", "bunfig.toml", ".bunfig.toml", "tsconfig.json", "jsconfig.json",
+		".env", ".env.local", ".env.test", ".env.test.local", ".env.development", ".env.production"];
+	const config = [...graph.keys()].some((p) => {
+		const name = p.slice(p.lastIndexOf("/") + 1);
+		return loaderNames.includes(name) || name.startsWith(".env.");
+	});
+	const results: Record<string, FileInputProof> = {};
+	for (const path of graph.keys()) {
+		if (!isTestFile(path)) continue;
+		const inputs = new Set<string>([path, ...FULL_SUITE_TRIGGERS]);
+		const seen = new Set<string>();
+		const visit = (p: string) => {
+			if (seen.has(p)) return;
+			seen.add(p); inputs.add(p);
+			for (const dep of graph.get(p) ?? []) visit(dep);
+		};
+		visit(path);
+		for (const p of graph.keys()) if (["package.json", "bun.lock", "bun.lockb", "bunfig.toml", "tsconfig.json", "jsconfig.json"].includes(p.slice(p.lastIndexOf("/") + 1))) inputs.add(p);
+		let reason = "closed primitive module grammar";
+		try {
+			if (config) throw new Error("unproven loader configuration");
+			const checked = new Set<string>();
+			const prove = (p: string): void => {
+				if (checked.has(p)) return;
+				checked.add(p);
+				if (!p.endsWith(".ts") && !p.endsWith(".js")) throw new Error("unsupported source language");
+				for (let directory = dirname(p); ; directory = dirname(directory)) {
+					if (loaderNames.some((name) => existsSync(join(root, directory, name)))) throw new Error("unproven loader configuration");
+					if (directory === ".") break;
+				}
+				const text = readFileSync(join(root, p), "utf8");
+				const specs = importsOf(text);
+				const parsed = new Bun.Transpiler({ loader: p.endsWith(".ts") ? "ts" : "js" }).scanImports(text);
+				if (parsed.some((item) => item.kind !== "import-statement")) throw new Error("non-static import");
+				for (const spec of specs) {
+					if (!spec.endsWith(".ts") && !spec.endsWith(".js")) throw new Error("extensionless import");
+					const target = normalize(join(dirname(p), spec));
+					if (target.startsWith("../") || !graph.has(target)) throw new Error("unresolved import");
+					if (target.endsWith(".js") && graph.has(target.slice(0, -3) + ".ts")) throw new Error("ambiguous JS/TS resolution");
+					inputs.add(target); prove(target);
+				}
+			};
+			prove(path);
+			results[path] = { inputs: [...inputs].sort(), provable: true, reason };
+		} catch (error) {
+			reason = error instanceof Error ? error.message : String(error);
+			results[path] = { inputs: [...inputs].sort(), provable: false, reason };
+		}
+	}
+	return results;
+}
+
+if (import.meta.main) process.stdout.write(JSON.stringify(proveFileInputs(process.argv[2]!)) + "\n");
