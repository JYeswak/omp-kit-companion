+#!/usr/bin/env python3
+"""FILEREUSE: native suite replays, input invalidation and unchanged OFF judgment."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import shutil
+import sys
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "scripts"))
+from kitlib_tmp import owned_tmp
+from kitlib_run import run
+
+
+class FileReuseTests(unittest.TestCase):
+    def test_closed_input_proof_refuses_unknown_effects(self) -> None:
+        with owned_tmp("file-input-proof") as temporary:
+            root = Path(temporary)
+            (root / "src").mkdir()
+            (root / "tests/cli").mkdir(parents=True)
+            (root / "src/leaf.ts").write_text("export const leaf = 7;\n")
+            middle = root / "src/mid.ts"
+            middle.write_text('import { leaf } from "./leaf.ts";\nexport function next(value) { return value + leaf; }\n')
+            test = root / "tests/cli/pure.test.ts"
+            body = ('import { test, expect } from "bun:test";\n'
+                    'import { next } from "../../src/mid.ts";\n'
+                    'test("calculation", () => { expect(next(1)).toBe(8); });\n')
+            test.write_text(body)
+
+            def proof() -> dict:
+                result = run(["nice", "-n", "10", "bun", "run", "--no-env-file", "--config=/dev/null",
+                              str(ROOT / "scripts/suite-file-inputs.ts"), str(root)],
+                             deadline_s=60, max_output_bytes=4 << 20)
+                self.assertEqual(result.rc, 0, result.stdout + result.stderr)
+                return json.loads(result.stdout)["tests/cli/pure.test.ts"]
+
+            control = proof()
+            self.assertTrue(control["provable"], control)
+            self.assertTrue({"src/leaf.ts", "src/mid.ts", "tests/cli/pure.test.ts"}.issubset(control["inputs"]))
+            for mutant in ('Bun.file("secret.txt");', 'globalThis["Bun"].file("secret.txt");',
+                           'eval("Bun.file(\\\"secret.txt\\\")");', 'process.env.HOME;',
+                           'import x from "node:fs";', 'import("./dynamic.ts");',
+                           'const escaped = "\\u0065val";',
+                           'test("ambient", () => { expect(Date.now()).toBe(0); });'):
+                test.write_text(body + "\n" + mutant + "\n")
+                self.assertFalse(proof()["provable"], mutant)
+            test.write_text(body)
+            middle.write_text(middle.read_text() + '\nconst unknown = Bun.file("hidden.txt");\n')
+            self.assertFalse(proof()["provable"])
+            middle.write_text('import { leaf } from "./leaf.ts";\nexport function next(value) { return value + leaf; }\n')
+            (root / "bunfig.toml").write_text('preload = ["./side-effect.ts"]\n')
+            self.assertFalse(proof()["provable"])
+
+    def test_native_cold_warm_invalidation_fail_and_off(self) -> None:
+        with owned_tmp("file-reuse-acceptance") as temporary:
+            base = Path(temporary)
+            repo, cache = base / "repo", base / "cache"
+            for directory in (repo / "scripts", repo / "src", repo / "tests/cli"):
+                directory.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(ROOT / "scripts/kitlib-tmp.sh", repo / "scripts/kitlib-tmp.sh")
+            (repo / "src/value.ts").write_text("export const value = 7;\n")
+            (repo / "src/other.ts").write_text("export const other = 11;\n")
+            for name, symbol in (("value", "value"), ("other", "other")):
+                (repo / f"tests/cli/{name}.test.ts").write_text(
+                    'import { test, expect } from "bun:test";\n'
+                    f'import {{ {symbol} }} from "../../src/{name}.ts";\n'
+                    f'test("{name} arithmetic", () => {{ expect({symbol} + 1).toBe({8 if name == "value" else 12}); }});\n')
+            # Unknown environmental inputs are executed on every tree, never inferred absent.
+            (repo / "tests/cli/external_test.py").write_text("import os\nassert os.getcwd()\n")
+            env = {key: value for key, value in os.environ.items()
+                   if not key.startswith("GIT_") and key not in ("BEADS_DIR", "BEADS_DB", "FULL_SUITE_FILE_REUSE",
+                                                                "BUN_CONFIG_FILE", "BUN_OPTIONS", "NODE_OPTIONS")}
+            home = base / "home"
+            home.mkdir()
+            env.update(RCH_DISABLE="1", RCH_LOCAL="1", FULL_SUITE_JOBS="2", OMP_KIT_OMP_SRC_FETCH="0",
+                       HOME=str(home), XDG_CONFIG_HOME=str(home / ".config"))
+
+            def command(argv: list[str], *, enabled: bool = True) -> tuple[int | None, str, float]:
+                selected = {**env, "FULL_SUITE_FILE_REUSE": "1"} if enabled else env
+                result = run(argv, env=selected, cwd=str(repo), deadline_s=180, max_output_bytes=16 << 20)
+                output = (result.stdout + result.stderr).decode(errors="replace")
+                self.assertFalse(result.timed_out or result.truncated, output)
+                print(json.dumps({"command": argv, "exit_code": result.rc, "wall_s": result.elapsed_s}), flush=True)
+                print(output, flush=True)
+                return result.rc, output, result.elapsed_s
+
+            def commit(message: str) -> str:
+                for args in (["add", "--all"], ["commit", "-qm", message]):
+                    rc, output, _ = command(["git", "-C", str(repo), *args])
+                    self.assertEqual(rc, 0, output)
+                result = run(["git", "-C", str(repo), "rev-parse", "HEAD"], env=env, deadline_s=10)
+                self.assertEqual(result.rc, 0, result.stderr)
+                return result.stdout.decode().strip()
+
+            def judge(label: str, *, enabled: bool = True, expected_rc: int = 0) -> tuple[dict, float]:
+                rc, output, wall = command(["nice", "-n", "10", "sh", str(ROOT / "scripts/full-suite-verdict.sh"),
+                                           "--repo", str(repo), "--commit", "HEAD", "--judge-role", "main",
+                                           "--cache-dir", str(cache)], enabled=enabled)
+                self.assertEqual(rc, expected_rc, output)
+                records = [json.loads(path.read_text()) for path in cache.glob("*.json")]
+                record = max(records, key=lambda value: value["timing"]["started_ms"])
+                print("FILEREUSE-SAMPLE " + json.dumps({"label": label, "wall_s": wall,
+                      "carried": record.get("file_reuse", {}).get("carried", []),
+                      "native": [row["path"] for row in record["evidence"]["files"] if row.get("origin") != "file-reuse"]}), flush=True)
+                return record, wall
+
+            for args in (["init", "-q"], ["config", "user.name", "FILEREUSE fixture"],
+                         ["config", "user.email", "filereuse@example.invalid"]):
+                rc, output, _ = command(["git", "-C", str(repo), *args])
+                self.assertEqual(rc, 0, output)
+            origin = commit("[test] cold fixture")
+            cold, cold_wall = judge("cold")
+            self.assertIn("file_reuse", cold)
+            self.assertEqual(cold["file_reuse"]["carried"], [])
+            # Changing exactly one src file must execute its consumer but carry the unrelated PASS.
+            (repo / "src/value.ts").write_text("export const value = 3 + 4;\n")
+            commit("[test] one source input changes")
+            warm, warm_wall = judge("one-src-warm", expected_rc=1)
+            carried = warm["file_reuse"]["carried"]
+            self.assertEqual([(row["path"], row["origin_commit"]) for row in carried],
+                             [("tests/cli/other.test.ts", origin)])
+            self.assertEqual([row["path"] for row in warm["evidence"]["files"] if row.get("origin") != "file-reuse"],
+                             ["tests/cli/external_test.py", "tests/cli/value.test.ts"])
+            self.assertEqual(warm["minimum_run"]["status"], "FAIL")
+            self.assertIn({"measure": "bun", "observed": 1, "minimum": 2}, warm["minimum_run"]["shortfalls"])
+            print(f"FILEREUSE-MEASURE cold_files=3 warm_files=2 cold_s={cold_wall:.3f} warm_s={warm_wall:.3f}", flush=True)
+            # Returning to previously proved bytes can carry every Bun file, but
+            # historical test counts must not masquerade as native execution.
+            (repo / "src/value.ts").write_text("export const value = 7;\n")
+            (repo / "README.md").write_text("new tree, unchanged proved inputs\n")
+            commit("[test] all Bun inputs match earlier PASS")
+            all_carried, _ = judge("all-bun-carried", expected_rc=1)
+            self.assertEqual(all_carried["evidence"]["bun_ran"], 0)
+            self.assertEqual([row["path"] for row in all_carried["file_reuse"]["carried"]],
+                             ["tests/cli/other.test.ts", "tests/cli/value.test.ts"])
+            self.assertIn({"measure": "bun", "observed": 0, "minimum": 2}, all_carried["minimum_run"]["shortfalls"])
+            # A new undeclared read is not accepted merely because the old import closure was pure.
+            test_path = repo / "tests/cli/other.test.ts"
+            test_path.write_text(test_path.read_text() + '\nawait Bun.file("undeclared.txt").text();\n')
+            (repo / "undeclared.txt").write_text("changed external input\n")
+            commit("[test] undeclared-read mutant")
+            mutant, _ = judge("undeclared-read", expected_rc=1)
+            self.assertNotIn("tests/cli/other.test.ts", [row["path"] for row in mutant["file_reuse"]["carried"]])
+            # The unchanged external file is still native, as is the newly unprovable TS file.
+            self.assertEqual(next(row for row in mutant["evidence"]["files"] if row["path"].endswith("other.test.ts")).get("origin"), None)
+            (repo / "src/value.ts").write_text("export const value = 9;\n")
+            commit("[test] failing changed input")
+            failed, _ = judge("fail", expected_rc=1)
+            self.assertEqual(next(row for row in failed["evidence"]["files"] if row["path"].endswith("value.test.ts"))["rc"], 1)
+            (repo / "README.md").write_text("new tree, same failed input\n")
+            commit("[test] failed input never carries")
+            failed_again, _ = judge("fail-never-carries", expected_rc=1)
+            self.assertNotIn("tests/cli/value.test.ts", [row["path"] for row in failed_again["file_reuse"]["carried"]])
+            (repo / "src/value.ts").write_text("export const value = 7;\n")
+            commit("[test] OFF runs every declared file")
+            off, _ = judge("off", enabled=False)
+            self.assertNotIn("file_reuse", off)
+            self.assertTrue(all(row.get("origin") != "file-reuse" for row in off["evidence"]["files"]))
+            # A declared runtime change invalidates even unrelated pure consumers.
+            test_path.write_text('import { test, expect } from "bun:test";\nimport { other } from "../../src/other.ts";\ntest("other", () => { expect(other).toBe(11); });\n')
+            (repo / "scripts/pysafe.py").write_text("# shared-runtime change\n")
+            commit("[test] shared runtime invalidates")
+            shared, _ = judge("shared-runtime")
+            self.assertEqual(shared["file_reuse"]["carried"], [])
+
+
+if __name__ == "__main__":
