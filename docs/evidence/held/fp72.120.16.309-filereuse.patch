+/**
+ * FILEREUSE needs a forward, transitive input graph, not the focused selector's
+ * intentionally one-hop naming heuristic. Include data references at every hop.
+ * This graph supplies candidate inputs only; suite-file-inputs proves closure.
+ */
+export function fileInputGraph(root: string): Map<string, string[]> {
+	const files = new Set(walk(root));
+	const graph = new Map<string, string[]>();
+	for (const rel of files) {
+		const edges = new Set<string>();
+		if (SCANNED_EXT.some((ext) => rel.endsWith(ext))) {
+			const text = readFileSync(join(root, rel), "utf8");
+			for (const target of referencedPaths(text, files, rel)) edges.add(target);
+			if (SOURCE_EXT.some((ext) => rel.endsWith(ext))) {
+				try {
+					for (const item of new Bun.Transpiler({ loader: loaderFor(rel) }).scanImports(text)) {
+						const target = resolveSpecifier(files, rel, item.path);
+						if (target) edges.add(target);
+					}
+				} catch { /* The independent closure proof refuses unparseable source. */ }
+			}
+			if (rel.endsWith(".py") && text.includes(EMBEDS_MARKER)) {
+				for (const [output, inputs] of Object.entries(declaredEmbeds(text, rel))) {
+					graph.set(output, [...(graph.get(output) ?? []), ...inputs]);
+				}
+			}
+			if (rel.endsWith(".py")) {
+				for (const module of pythonImports(text)) {
+					for (const target of [join(dirname(rel), `${module}.py`), `scripts/${module}.py`]) {
+						if (files.has(target)) edges.add(target);
+					}
+				}
+			}
+		}
+		graph.set(rel, [...new Set([...(graph.get(rel) ?? []), ...edges])].sort());
+	}
+	return graph;
+}
