    "cc.self": {
      "version": 1,
      "seat_scoped": false,
      "doc": "The command center measuring itself (CC11 bead ompkit-fp72.120.16.15.10): one envelope per committed ingest pass, emitted after run_once commits, never under --replay. Units, every field numeric: ingest_lag_ms (milliseconds, now minus min observed_ms over envelopes accepted this pass, 0 when none); spool_backlog_bytes (bytes beyond cursors); wal_bytes (bytes of cc.db-wal, 0 when absent); rss_peak_mb (mebibytes, ru_maxrss peak); pass_cpu_ms and pass_wall_ms (milliseconds of the committed pass); dead_letters_total and conflicts_total (row counts); open_unknowns_by_class (open unknown counts keyed by the 14 unknown classes).",
      "data": {
        "ingest_lag_ms": {
          "type": "integer",
          "minimum": 0
        },
        "spool_backlog_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "wal_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "rss_peak_mb": {
          "type": "number",
          "minimum": 0
        },
        "pass_cpu_ms": {
          "type": "number",
          "minimum": 0
        },
        "pass_wall_ms": {
          "type": "number",
          "minimum": 0
        },
        "dead_letters_total": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts_total": {
          "type": "integer",
          "minimum": 0
        },
        "open_unknowns_by_class": {
          "type": "object",
          "fields": {
            "U-identity": {
              "type": "integer",
              "minimum": 0
            },
            "U-category": {
              "type": "integer",
              "minimum": 0
            },
            "U-bead": {
              "type": "integer",
              "minimum": 0
            },
            "U-mission": {
              "type": "integer",
              "minimum": 0
            },
            "U-type": {
              "type": "integer",
              "minimum": 0
