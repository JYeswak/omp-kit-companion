        "usage_key": {
          "type": "string",
          "min_length": 1,
          "max_length": 256
        },
        "cost_source": {
          "type": "string",
          "enum": [
            "provider",
            "derived",
            "unknown"
          ]
        },
        "reasoning_source": {
          "type": "string",
          "enum": [
