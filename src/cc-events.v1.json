          "type": "string",
          "nullable": true,
          "code": true
        },
        "skew_ms": {
          "type": "integer",
          "nullable": true
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "fields": {
              "record_type": {
                "type": "string",
                "max_length": 128
