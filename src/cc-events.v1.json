    "source.tick": {
      "version": 1,
      "seat_scoped": false,
      "doc": "Physical records_seen counts each complete source record once, partitioned into emitted/ignored/quarantined; coverage counts use the same denominator, never event fanout. Optional event_count counts semantic output events separately (0..N), not the tick itself; missing means unreported/SQL NULL, never invented zero. A quiet collector pass still emits source.tick with zero physical counts.",
      "data": {
        "event_count": {
          "type": "integer",
          "required": false,
          "minimum": 0
        },
        "instance": {
          "type": "string",
          "code": true
        },
