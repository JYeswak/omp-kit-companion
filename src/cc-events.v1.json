          "required": false,
          "nullable": true,
          "max_length": 64
        },
        "pricing": {
          "type": "object",
          "required": false,
          "nullable": true,
          "fields": {
            "pricing_sha": {
              "type": "string",
              "max_length": 64
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cache_read_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cache_write_tokens": {
