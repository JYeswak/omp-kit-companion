{
  "schema_version": "omp-kit.secret-output-policy.v1",
  "patterns": {
    "GH_CLASSIC": { "pattern": "\\bgh[po]_[A-Za-z0-9]{8,}", "flags": "g" },
    "GH_FINE_GRAINED": { "pattern": "\\bgithub_pat_[A-Za-z0-9_]{8,}", "flags": "g" },
    "HOSTS_OAUTH_TOKEN": { "pattern": "^([ \\t]*oauth_token[ \\t]*:[ \\t]*)(\\S+)[ \\t]*$", "flags": "gm" },
    "SECURITY_PASSWORD": { "pattern": "(password[ \\t]*:[ \\t]*)(?:\"[^\"\\n]*\"|'[^'\\n]*')", "flags": "g" }
  },
  "replay_patterns": {
    "GENERIC_ASSIGNMENT": {
      "pattern": "(\\b(?:authorization|proxy-authorization|api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret|token|password|passwd|secret)\\b[\"']?\\s*[:=]\\s*)(?:\"(?:[^\"\\\\]|\\\\[\\s\\S])*(?:\"|\\\\?$)|'(?:[^'\\\\]|\\\\[\\s\\S])*(?:'|\\\\?$)|[^\\s,;\"'<>]+)",
      "flags": "gi"
    }
  },
  "binding_keys": ["registration_token", "sender_token", "bearer_token", "session_token", "access_token", "refresh_token", "auth_token"]
}
